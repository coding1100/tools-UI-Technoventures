# Backend API base URL, including the /v1 prefix.
BACKEND_API_URL=https://api.example.com/v1

# The single team account (create it with scripts/create-unlimited-user.js in
# the backend repo). Server-side only: never prefix these with NEXT_PUBLIC_.
TEAM_ACCOUNT_EMAIL=
TEAM_ACCOUNT_PASSWORD=

# Name shown in the header and browser tab.
NEXT_PUBLIC_APP_NAME=Team Tools
