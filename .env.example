# Required. Backend API base URL, including the /v1 prefix.
BACKEND_API_URL=https://api.example.com/v1

# Required. The team account (create it with scripts/create-unlimited-user.js
# in the backend repo). The app calls the backend as this account, and the same
# email and password are the app's sign-in. Server-side only: never prefix
# these with NEXT_PUBLIC_.
TEAM_ACCOUNT_EMAIL=team@technoventures.com
TEAM_ACCOUNT_PASSWORD=

# Optional. Name shown in the header and browser tab (default: Team Tools).
NEXT_PUBLIC_APP_NAME=Team Tools
